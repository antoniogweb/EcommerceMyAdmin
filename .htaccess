Options -Indexes

# <IfModule mod_rewrite.c>
# 	Options +FollowSymlinks
	RewriteEngine on
	# File Git
	RewriteRule (^|/)\.git(ignore|modules)$ - [R=404,L]

	# Cartella .git
	RewriteRule (^|/)\.git(/|$) - [R=404,L]

	# Cartella Log
# 	RewriteRule (^|/)Logs(/|$) - [R=404,L]
	# Consenti solo Logs/CaptchaDDOS
	RewriteCond %{REQUEST_URI} ^/Logs/ [NC]
	RewriteCond %{REQUEST_URI} !^/Logs/CaptchaDDOS(/|$) [NC]
	RewriteRule ^ - [R=404,L]
	
	# Blocca README.md
	RewriteRule (^|/)README\.md$ - [R=404,L,NC]

	# Compatibilità temporanea: vecchi percorsi jQuery e jQuery UI.
	# Le risorse vengono servite dai vendor npm senza passare da index.php.
	RewriteRule ^Frontend/Public/Js/jquery-3\.5\.1\.min\.js$ Frontend/Public/Js/vendor/jquery/jquery.min.js [L]
	RewriteRule ^Frontend/Public/Js/jquery-ui-1\.13\.2\.custom/jquery-ui\.min\.js$ Frontend/Public/Js/vendor/jquery-ui/jquery-ui.min.js [L]
	RewriteRule ^Frontend/Public/Js/jquery-ui-1\.13\.2\.custom/jquery-ui\.min\.css$ Frontend/Public/Js/vendor/jquery-ui/jquery-ui.min.css [L]
	RewriteRule ^Frontend/Public/Js/jquery-ui-1\.13\.2\.custom/main/ui/i18n/(datepicker-[A-Za-z-]+\.js)$ Frontend/Public/Js/vendor/jquery-ui/i18n/$1 [L]
	RewriteRule ^Frontend/Public/Js/jquery-ui-1\.13\.2\.custom/images/(.+)$ Frontend/Public/Js/vendor/jquery-ui/images/$1 [L]
	
	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteCond %{REQUEST_FILENAME} !-d
	
	RewriteRule ^(.*)$ index.php?url=$1 [B,QSA,L]
# </IfModule>
 
